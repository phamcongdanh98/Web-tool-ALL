# Local defaults. Production overrides these values through systemd.
NODE_ENV=development
HOST=127.0.0.1
PORT=3001

# Giới hạn tổng dữ liệu tệp mỗi lượt. Nén PDF nhận 50 MB/tệp; công cụ khác 25 MB/tệp.
MAX_UPLOAD_TOTAL_MB=50
MAX_CONCURRENT_JOBS=2

# Optional: configure this later to persist user data/newsletter subscriptions.
MONGODB_URI=mongodb://localhost:27017/toolhub

# Telegram Bot thông báo lượt dùng công cụ & quản trị thống kê 2 chiều
# Lấy token từ @BotFather và Chat ID từ @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_NOTIFY_TOOL_USE=true
TELEGRAM_DAILY_REPORT=true
TELEGRAM_POLLING=true

# Mật mã quản trị viên mở khóa bảng thống kê IP & lưu lượng trên trang web
ADMIN_STATS_PASSWORD=danhadmin2026
