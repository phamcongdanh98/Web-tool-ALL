# Local defaults. Production overrides these values through systemd.
NODE_ENV=development
HOST=127.0.0.1
PORT=3001

# Giới hạn tổng dữ liệu tệp mỗi lượt. Nén PDF nhận 50 MB/tệp; công cụ khác 25 MB/tệp.
MAX_UPLOAD_TOTAL_MB=50
MAX_CONCURRENT_JOBS=2

# Optional: configure this later to persist user data/newsletter subscriptions.
MONGODB_URI=mongodb://localhost:27017/toolhub
