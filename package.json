{
  "name": "toolhub-vietnamese",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -k -n API,WEB -c yellow,cyan \"npm:server\" \"npm:client\"",
    "client": "vite",
    "server": "node server.js",
    "build": "vite build && node scripts/precompress-assets.mjs",
    "preview": "vite preview",
    "start": "node server.js",
    "check:shell": "bash -n deploy/setup-ubuntu.sh && bash -n deploy/configure-domain.sh && bash -n deploy/deploy.sh && bash -n deploy/remote.sh && bash -n deploy/status.sh && bash -n scripts/smoke-production.sh",
    "test:smoke": "bash scripts/smoke-production.sh",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "verify": "node --check server.js && node --check scripts/e2e-api.mjs && node --check scripts/precompress-assets.mjs && npm run check:shell && npm run build && npm run test:smoke",
    "deploy:vps": "bash deploy/remote.sh",
    "status:vps": "bash deploy/status.sh"
  },
  "dependencies": {
    "@imgly/background-removal": "^1.7.0",
    "archiver": "^8.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "multer": "^2.2.0",
    "onnxruntime-web": "^1.21.0-dev.20250206-d981b153d3",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.2.108",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^10.0.5",
    "vite": "^6.1.0"
  }
}
